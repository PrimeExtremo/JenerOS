#!/bin/sh
# Runs INSIDE the image, never on Jener's Windows host.
set -eu
[ "$1" = final ] || exit 0
mkdir -p /usr/share/keyrings /etc/apt/sources.list.d
curl --fail --silent --show-error --location https://pkgs.zabbly.com/key.asc -o /tmp/zabbly.asc
fingerprint=$(gpg --batch --show-keys --with-colons /tmp/zabbly.asc | awk -F: '$1 == "fpr" { print $10; exit }')
[ "$fingerprint" = 4EFC590696CB15B87C73A3AD82CC8797C838DCFD ] || { echo 'Unexpected Zabbly signing key' >&2; exit 1; }
cp /tmp/zabbly.asc /usr/share/keyrings/zabbly-incus.asc
cat > /etc/apt/sources.list.d/zabbly-incus.sources <<'EOF'
Types: deb
URIs: https://pkgs.zabbly.com/incus/lts-7.0
Suites: trixie
Components: main
Signed-By: /usr/share/keyrings/zabbly-incus.asc
EOF
apt-get update
dpkg-query -W -f='${Package}\n' | sort > /tmp/jeneros-packages-before
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends incus
version=$(dpkg-query -W -f='${Version}' incus)
case "$version" in 1:7.0*|7.0*) ;; *) echo 'Expected Incus 7.0 LTS' >&2; exit 1 ;; esac
# Zabbly ships its runtime in /opt. Keep those binaries in the A/B payload.
test -d /opt/incus
test ! -e /usr/lib/incus
mv /opt/incus /usr/lib/incus
ln -s /usr/lib/incus /opt/incus
# Package conffiles on /etc would otherwise be absent when upgrading an old
# image: A/B updates replace only /usr. Ship defaults in /usr and copy missing
# files at boot, preserving any existing administrator configuration.
dpkg-query -W -f='${Package}\n' | sort > /tmp/jeneros-packages-after
mkdir -p /usr/lib/tmpfiles.d /usr/lib/jeneros/vendor-defaults
: > /usr/lib/tmpfiles.d/jeneros-incus-defaults.conf
comm -13 /tmp/jeneros-packages-before /tmp/jeneros-packages-after | while IFS= read -r package; do
    dpkg-query -L "$package" | while IFS= read -r file; do
        case "$file" in /etc/*) ;; *) continue ;; esac
        # Package paths are trusted, but only simple paths belong in tmpfiles.
        case "$file" in *[!A-Za-z0-9_./-]*) echo 'Unsupported package config path' >&2; exit 1 ;; esac
        if [ -f "$file" ] && [ ! -L "$file" ]; then
            dest="/usr/lib/jeneros/vendor-defaults$file"
            mkdir -p "$(dirname "$dest")"
            cp -p "$file" "$dest"
            printf 'C %s - - - - %s\n' "$file" "$dest" >> /usr/lib/tmpfiles.d/jeneros-incus-defaults.conf
        fi
    done
done
# The immutable image supplies defaults. Runtime state is created at boot.
mkdir -p /usr/lib/jeneros
cp /etc/apt/sources.list.d/zabbly-incus.sources /usr/lib/jeneros/zabbly-incus.sources
rm -f /etc/apt/sources.list.d/zabbly-incus.sources /tmp/zabbly.asc /tmp/jeneros-packages-before /tmp/jeneros-packages-after
