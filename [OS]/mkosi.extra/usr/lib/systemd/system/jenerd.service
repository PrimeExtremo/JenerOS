[Unit]
Description=JenerOS core daemon (dashboard + API)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/jenerd -setup -addr :80 -store /usr/share/jeneros/store/apps -web /usr/share/jeneros/dashboard
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Restart=on-failure
# The dashboard asks for an update by creating /run/jeneros/update.request.
RuntimeDirectory=jeneros
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
