[Unit]
Description=JenerOS core daemon (dashboard + API)
After=network-online.target
Wants=network-online.target
Wants=jeneros-auth.socket

[Service]
ExecStart=/usr/bin/jenerd -setup -addr :80 -tls-addr :443 -store /usr/share/jeneros/store/apps -web /usr/share/jeneros/dashboard
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
LimitCORE=0
Restart=on-failure
# The dashboard asks for an update by creating /run/jeneros/update.request.
RuntimeDirectory=jeneros
RuntimeDirectoryMode=0755
StateDirectory=jeneros-tls
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Disk inventory uses sysfs/udev and /dev identities. Never grant raw-disk caps.
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
MemoryDenyWriteExecute=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
