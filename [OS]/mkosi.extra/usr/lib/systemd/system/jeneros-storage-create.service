[Unit]
Description=Create JenerOS storage on empty disks

[Service]
Type=oneshot
ExecStart=/usr/lib/jeneros/storage-create
RuntimeDirectory=jeneros-storage
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
TimeoutStartSec=21min
UMask=0022
# Must share the host mount namespace: the new pool belongs to the whole box.
