[Unit]
Description=JenerOS on this screen
Wants=jenerd.service
BindsTo=jenerd.service
PartOf=jenerd.service
After=jenerd.service plymouth-quit-wait.service systemd-user-sessions.service systemd-logind.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=120
StartLimitBurst=3
OnFailure=jeneros-kiosk-fallback.service

[Service]
User=jeneros-kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=no
UtmpIdentifier=tty1
UtmpMode=user
RuntimeDirectory=jeneros-kiosk
RuntimeDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/jeneros-kiosk
# Draw in software: VMs without 3D and PCs with unsupported GPUs have no usable
# EGL, and a setup/status page doesn't need a GPU. Without this the screen stays black.
Environment=WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1
EnvironmentFile=-/var/lib/jeneros/kiosk-keyboard
ExecStart=/usr/lib/jeneros/kiosk
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
