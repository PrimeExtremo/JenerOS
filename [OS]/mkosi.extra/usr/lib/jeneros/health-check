#!/bin/sh
# Passes once jenerd answers. Ordered before boot-complete.target, so a newly
# installed version is only marked "good" when the dashboard actually works.
# If it fails on a counted boot (a fresh update), mark the boot bad and reboot:
# systemd-boot then falls back to the previous version.
i=0
while [ "$i" -lt 30 ]; do
    curl -sf -o /dev/null http://127.0.0.1/api/system && exit 0
    i=$((i + 1))
    sleep 2
done
echo "jenerd did not answer within 60s" >&2
if [ "$(/usr/lib/systemd/systemd-bless-boot status 2>/dev/null)" = indeterminate ]; then
    echo "new version is unhealthy: marking this boot bad and rebooting" >&2
    /usr/lib/systemd/systemd-bless-boot bad
    systemctl reboot
fi
exit 1
