#!/bin/sh
# JenerOS updates, run as root by systemd units (never by jenerd directly).
#   update check   -> /run/jeneros-update/available.json
#   update apply   -> download into the B slot, then reboot into it
set -u
SYSUPDATE=/usr/lib/systemd/systemd-sysupdate
DIR=/run/jeneros-update
mkdir -p "$DIR"
# The same root-owned lock protects updates and manual slot switching.
exec 9>"$DIR/action.lock"
if ! flock -n 9; then
    rm -f /run/jeneros/update.request /run/jeneros/check.request
    exit 1
fi

write() { # file json
    printf "%s\n" "$2" > "$DIR/$1.tmp" && mv "$DIR/$1.tmp" "$DIR/$1"
}
status() { # state version
    write status.json "{\"state\":\"$1\",\"version\":\"$2\",\"time\":\"$(date -Is)\"}"
}

# check-new exits 1 both for "nothing newer" and "server unreachable";
# list only fails when the update source can't be read.
if ! "$SYSUPDATE" list >/dev/null 2>&1; then
    rm -f /run/jeneros/update.request /run/jeneros/check.request
    write available.json "{\"error\":\"Can't reach the update server\",\"checked\":\"$(date -Is)\"}"
    [ "${1:-}" = apply ] && status failed ""
    exit 1
fi
new=$("$SYSUPDATE" check-new 2>/dev/null | tail -n1)
case "${1:-}" in
check)
    rm -f /run/jeneros/check.request
    # A version that failed its boot tries is left on the ESP as <name>+0-N.efi.
    bad=$(ls /boot/EFI/Linux/ 2>/dev/null | sed -n 's/^jeneros_\(.*\)+0-[0-9]*\.efi$/\1/p' | sort -V | tail -n1)
    write available.json "{\"version\":\"$new\",\"rolledBack\":\"$bad\",\"checked\":\"$(date -Is)\"}"
    ;;
apply)
    rm -f /run/jeneros/update.request
    if [ -z "$new" ]; then status uptodate ""; exit 0; fi
    status installing "$new"
    if "$SYSUPDATE" update; then
        status rebooting "$new"
        systemctl reboot
    else
        status failed "$new"
        exit 1
    fi
    ;;
*)
    echo "usage: update check|apply" >&2
    exit 2
    ;;
esac
